# Скопируй в .env и поправь значения.

# TikTok-ник без @. Пока CHANGE_ME — работают фейковые зрители.
TIKTOK_USERNAME=CHANGE_ME

# 1 = фейковые зрители (проверка без стрима), 0 = реальный чат TikTok
SIMULATE=0

# Порт на ПК, на котором откроется игра: http://localhost:HOST_PORT
HOST_PORT=8765

# Игровые настройки
STEP_PCT=1.0
TAP_COOLDOWN_SEC=1.0
# Один и тот же зритель за одну и ту же команду — не чаще раза в N секунд
TEAM_COOLDOWN_SEC=5
WIN_PAUSE_SEC=15
