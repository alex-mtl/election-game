# Скопируй в .env и поправь значения. После правки: docker compose up -d

# ---------- общее ----------
# TikTok-ник без @. Пока CHANGE_ME — играют фейковые зрители.
TIKTOK_USERNAME=CHANGE_ME
# 1 = фейковые зрители (проверка без стрима), 0 = реальный чат TikTok
SIMULATE=0
# Порт на ПК: http://localhost:HOST_PORT
HOST_PORT=8765
# Игра по умолчанию при первом запуске: battle | guess
DEFAULT_GAME=battle
# Страница /debug и /api/debug/* (кнопки для теста событий)
DEBUG_CONTROLS=1

# ---------- Team Battle (перетяжка) ----------
STEP_PCT=1.0
TAP_COOLDOWN_SEC=1.0
# Один и тот же зритель за одну и ту же команду — не чаще раза в N секунд
TEAM_COOLDOWN_SEC=5
WIN_PAUSE_SEC=15

# ---------- Guess the Word ----------
# Длительность раундов, сек
ROUND_DURATION=210
SPEED_ROUND_DURATION=75
# Каждый N-й раунд — SPEED (0 = никогда)
SPEED_ROUND_EVERY=4
# Один зритель — не чаще одной догадки в N секунд
GUESS_COOLDOWN_SECONDS=3
# Пауза между раундами: экран победителя + итоги и промо (WINNER_SEC + REVEAL_SEC ≈ 2 мин)
WINNER_SEC=5
REVEAL_SEC=115
# Первые N секунд паузы — итоги раунда, дальше — промо-экран (подписка, правила, лидеры)
RESULTS_SEC=25
# Строки промо-экрана через |
PROMO_LINES=FOLLOW so you never miss a round|SUBSCRIBE to join the game|Invite friends - more players, more fun
# Границы температур по рангу: PERFECT,BURNING,VERY HOT,HOT,WARM,COLD (дальше FREEZING)
TEMPERATURE_BOUNDS=1,10,50,200,1000,5000
# Сложность слов подстраивается: быстрые победы -> сложнее, никто не близко -> проще
DYNAMIC_DIFFICULTY=1
# Автоподсказка в середине раунда, если никто не подобрался ближе #300
AUTO_HINT=1
# Порядок типов подсказок: semantic,category,letter,distance
HINT_TYPES=semantic,category,letter,semantic
HINT_COOLDOWN_SEC=20
# Подарки (названия через запятую): дают подсказку / запускают новый раунд
GIFT_HINT_NAMES=Rose
GIFT_NEW_ROUND_NAMES=
# Показать плашку "SUBSCRIBERS ONLY"
SUBSCRIBERS_ONLY=0
# Цель стрима по подпискам (0 = не показывать)
GOAL_LABEL=FOLLOW GOAL
GOAL_TARGET=0
